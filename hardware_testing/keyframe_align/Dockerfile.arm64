# Reproducible architecture check; not a claim of matching the Pi's package versions.
FROM --platform=linux/arm64 ros:jazzy-ros-base
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake python3-colcon-common-extensions python3-pytest \
    ros-jazzy-controller-interface ros-jazzy-hardware-interface \
    ros-jazzy-realtime-tools ros-jazzy-generate-parameter-library \
    ros-jazzy-tf2 ros-jazzy-controller-manager ros-jazzy-ament-cmake-pytest \
    ros-jazzy-ament-lint-auto ros-jazzy-ament-lint-common libboost-dev \
    && rm -rf /var/lib/apt/lists/*
ENV CMAKE_BUILD_PARALLEL_LEVEL=2
