        <joint name="leg_back_l_3">
            <!-- WHEEL joint (was the knee), continuous. Position limits are widened so the
                 wheel can spin freely, and homing disarmed (homing_kp/velocity 0)
                 because a free-spinning wheel has no home angle to seek and a
                 homing sweep would spin it on startup.

                 homing_torque_threshold is 0.0 ON PURPOSE and is load-bearing, because
                 control_board_hardware_interface homes in a BLOCKING
                 while(!all_homed) loop that only exits when a joint pushes past
                 its torque threshold. A free-spinning wheel has no hard stop, so
                 it can never reach any nonzero threshold; with the stock 2.0 the
                 robot would hang at startup and never activate. Threshold 0.0 marks
                 the joint homed on the first iteration with zero motion, and since
                 homed_position == post_homing_position the follow-up return loop
                 also completes immediately. REVIEW BEFORE HARDWARE. -->
            <param name="can_channel">3</param>
            <param name="can_id">3</param>

            <param name="homing_stage">0</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">-0.71</param>
            <param name="post_homing_position">-0.71</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>

            <param name="position_min">-1000.0</param>
            <param name="position_max">1000.0</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>


        <sensor name="imu_sensor">
            <param name="yaw">0</param>
            <param name="pitch">-2.35619</param>
            <param name="roll">0</param>

            <state_interface name="orientation.x"/>
            <state_interface name="orientation.y"/>
            <state_interface name="orientation.z"/>
            <state_interface name="orientation.w"/>
            <state_interface name="angular_velocity.x"/>
            <state_interface name="angular_velocity.y"/>
            <state_interface name="angular_velocity.z"/>
            <state_interface name="linear_acceleration.x"/>
            <state_interface name="linear_acceleration.y"/>
            <state_interface name="linear_acceleration.z"/>
        </sensor>

    </xacro:macro>

</robot>
