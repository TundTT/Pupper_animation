<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="gravity_pose" value="${xacro.load_yaml('$(find pupper_v3_description)/config/gravity_pose.yaml')}" /><xacro:macro name="define_components">
    <joint name="leg_front_r_1">
      <param name="can_channel">2</param>
      <param name="can_id">1</param>
      <param name="gravity_position">${gravity_pose['joint_positions']['leg_front_r_1']}</param>
      <param name="position_min">-1.12</param>
      <param name="position_max">2.41</param>
      <param name="velocity_max">30.0</param>
      <param name="effort_max">3.0</param>
      <param name="kp_max">10.0</param>
      <param name="kd_max">1.0</param>
      <command_interface name="position" />
      <command_interface name="velocity" />
      <command_interface name="effort" />
      <command_interface name="kp" />
      <command_interface name="kd" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
    <joint name="leg_front_r_2">
      <param name="can_channel">2</param>
      <param name="can_id">2</param>
