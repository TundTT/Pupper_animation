<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="define_components">


        <joint name="leg_front_r_1">
            <param name="can_channel">2</param>
            <param name="can_id">1</param>
            <!-- No hard stop on this leg design, so homing is disarmed (homing_kp/velocity/
                 threshold all 0), same pattern as the wheel joints. homed_position is the
                 gravity-droop equilibrium angle for this joint (computed via MuJoCo root-
                 solve on the leg branch CustomLegFoot model + independent per-side energy
                 check; left/right are NOT exact mirrors; verified visually against
                 photos of the real leg hanging free). Requires the leg to actually be
                 hanging freely (unpowered) at boot for this to be correct; if the leg is
                 resting on something or held, re-derive. REVIEW BEFORE HARDWARE. -->


            <param name="homing_stage">2</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">0.990537</param>
            <param name="post_homing_position">0.990537</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>

            <param name="position_min">-1.12</param>
            <param name="position_max">2.41</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_r_2">
            <param name="can_channel">2</param>
            <param name="can_id">2</param>
            <!-- No hard stop on this leg design, so homing is disarmed (homing_kp/velocity/
                 threshold all 0), same pattern as the wheel joints. homed_position is the
                 gravity-droop equilibrium angle for this joint (computed via MuJoCo root-
                 solve on the leg branch CustomLegFoot model + independent per-side energy
                 check; left/right are NOT exact mirrors; verified visually against
                 photos of the real leg hanging free). Requires the leg to actually be
                 hanging freely (unpowered) at boot for this to be correct; if the leg is
                 resting on something or held, re-derive. REVIEW BEFORE HARDWARE. -->


            <param name="homing_stage">1</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">-0.179972</param>
            <param name="post_homing_position">-0.179972</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>

            <param name="position_min">-0.32</param>
            <param name="position_max">3.04</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_r_3">
            <param name="can_channel">2</param>
            <param name="can_id">3</param>
            <!-- No hard stop on this leg design, so homing is disarmed (homing_kp/velocity/
                 threshold all 0), same pattern as the wheel joints. homed_position is the
                 gravity-droop equilibrium angle for this joint (computed via MuJoCo root-
                 solve on the leg branch CustomLegFoot model + independent per-side energy
                 check; left/right are NOT exact mirrors; verified visually against
                 photos of the real leg hanging free). Requires the leg to actually be
                 hanging freely (unpowered) at boot for this to be correct; if the leg is
                 resting on something or held, re-derive. REVIEW BEFORE HARDWARE. -->


            <param name="homing_stage">0</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">-1.045141</param>
            <param name="post_homing_position">-1.045141</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>

            <param name="position_min">-2.69</param>
            <param name="position_max">0.61</param>
            <param name="hard_limit_min">-2.615937</param>
            <param name="hard_limit_max">0.525655</param>
            <!-- hard_limit_min/max is +-90 deg around home (hardware-measured "comfortable
                 max" was 102-120 deg per side, each leg measured individually; see the
                 leg-calibration session notes). This is the REAL mechanical protection,
                 enforced unconditionally in copy_actuator_commands()'s hard end-stop from
                 the actual measured position, regardless of control mode (position or
                 velocity) or which controller is active; unlike position_min/max above,
                 which is left at its original wider value on purpose, because that pair is a soft
                 command clip only enforced under active position control, sized with
                 headroom inside what deployed policies actually command, and must NOT be
                 reused as a substitute for a real limit (an earlier version of this file
                 did exactly that, which broke on review; it collided with the deployed
                 locomotion policy's own envelope on this and other joints). velocity_max
                 is also reduced from the walk/locomotion default (30) on this joint alone,
                 to bound worst-case kinetic energy hitting the hard limit; legged walking
                 does not need anywhere near 30 rad/s on a knee joint. -->
            <param name="velocity_max">15.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

