                 photos of the real leg hanging free). Requires the leg to actually be
                 hanging freely (unpowered) at boot for this to be correct; if the leg is
                 resting on something or held, re-derive. REVIEW BEFORE HARDWARE. -->


            <param name="homing_stage">1</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">-0.179972</param>
            <param name="post_homing_position">-0.179972</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>

            <param name="position_min">-0.32</param>
            <param name="position_max">3.04</param>
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

        <joint name="leg_front_r_3">
            <param name="can_channel">2</param>
            <param name="can_id">3</param>
            <!-- No hard stop on this leg design, so homing is disarmed (homing_kp/velocity/
                 threshold all 0), same pattern as the wheel joints. homed_position is the
                 gravity-droop equilibrium angle for this joint (computed via MuJoCo root-
                 solve on the leg branch CustomLegFoot model + independent per-side energy
                 check; left/right are NOT exact mirrors; verified visually against
                 photos of the real leg hanging free). Requires the leg to actually be
                 hanging freely (unpowered) at boot for this to be correct; if the leg is
                 resting on something or held, re-derive. REVIEW BEFORE HARDWARE. -->


            <param name="homing_stage">0</param>
            <param name="homing_velocity">0.0</param>
            <param name="homed_position">-1.045141</param>
            <param name="post_homing_position">-1.045141</param>
            <param name="homing_kp">0.0</param>
            <param name="homing_kd">0.2</param>
            <param name="homing_torque_threshold">0.0</param>
            <!-- Raw pre-homing sensor reading recorded on 2026-09-05 with this leg
                 confirmed hanging freely, untouched, reproduced identically across 3
                 consecutive power cycles. See do_homing() for the check this enables.
                 Updated 2026-09-07, boot reading drifted to 0.0727 (3.4 deg); leg
                 visually confirmed still hanging freely in the correct gravity-drop
                 pose, so the reference was moved to match. -->
            <param name="homing_reference_raw">-0.015800</param>

            <param name="position_min">-1000.0</param>
            <param name="position_max">1000.0</param>
            <!-- WHEEL-ALIGN-HYBRID TEST (2026-09-09), position_min/max widened and
                 hard_limit_min/max removed. A continuous wheel is now physically mounted
                 on this joint (no mechanical stop), and neural_controller_wheel_align_hybrid
                 commands a 180-degree turn that the prior +-90-deg-from-home leg clamp
                 would fight. hard_limit_min/max defaults to +-infinity when absent (see
                 control_board_hardware_interface.cpp's OPTIONAL hard_limit_min/max comment).
                 REVERT before putting the CustomLegFoot leg back on this joint,
                 position_min -2.69, position_max 0.61, hard_limit_min -2.615937,
                 hard_limit_max 0.525655, velocity_max 15.0. -->
            <param name="velocity_max">30.0</param>
            <param name="effort_max">3.0</param>
            <param name="kp_max">10.0</param>
            <param name="kd_max">1.0</param>

            <command_interface name="position"/>
            <command_interface name="velocity"/>
            <command_interface name="effort"/>
            <command_interface name="kp"/>
            <command_interface name="kd"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>

