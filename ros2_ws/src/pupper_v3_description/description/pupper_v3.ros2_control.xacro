<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find pupper_v3_description)/description/components.xacro" />
    <xacro:macro name="pupper_v3_system">
        <xacro:property name="upper_home" value="${xacro.load_yaml('$(find pupper_v3_description)/description/upper_home.yaml')}" />
        <ros2_control name="control_board_hardware_interface" type="system">
            <hardware>
                <plugin>control_board_hardware_interface/ControlBoardHardwareInterface</plugin>
                <param name="startup_upper_home">true</param>
                <param name="upper_home_leg_front_r_1">${upper_home['leg_front_r_1']}</param>
                <param name="upper_home_leg_front_r_2">${upper_home['leg_front_r_2']}</param>
                <param name="upper_home_leg_front_l_1">${upper_home['leg_front_l_1']}</param>
                <param name="upper_home_leg_front_l_2">${upper_home['leg_front_l_2']}</param>
                <param name="upper_home_leg_back_r_1">${upper_home['leg_back_r_1']}</param>
                <param name="upper_home_leg_back_r_2">${upper_home['leg_back_r_2']}</param>
                <param name="upper_home_leg_back_l_1">${upper_home['leg_back_l_1']}</param>
                <param name="upper_home_leg_back_l_2">${upper_home['leg_back_l_2']}</param>
                <!-- <param name="use_imu">false</param> -->
            </hardware>
            <xacro:define_components />
        </ros2_control>
    </xacro:macro>

</robot>
